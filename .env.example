# Copy this file to .env and replace the placeholder values.
SECRET_KEY=generate-a-long-random-secret-key
DATABASE_URL=sqlite:///instance/parksmart.db

# Hardware
SIMULATOR_MODE=false
SERIAL_PORT=COM5
SERIAL_BAUDRATE=115200
SERIAL_TIMEOUT=1.0
TOTAL_SLOTS=4
HARDWARE_AUTOSTART=true
HARDWARE_STALE_SECONDS=10

# Time and reservations
TIMEZONE=Asia/Kolkata
RESERVATION_EARLY_MINUTES=15
RESERVATION_LOCK_MINUTES=5
ENTRY_TIMEOUT_MINUTES=10
WALKIN_HOLD_MINUTES=60

# Gate and billing
GATE_OPEN_SECONDS=5
PARKING_RATE_FIRST_HOUR=20
PARKING_RATE_ADDITIONAL_HOUR=10
CURRENCY=INR

# Used in password-reset links
PUBLIC_BASE_URL=http://127.0.0.1:5000

# Gmail SMTP; use a Google App Password, not your normal password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=your-address@gmail.com
SMTP_STARTTLS=true
ASYNC_EMAIL=true

# Optional application settings
CSRF_ENABLED=true
